# ==============================================================================
# КОНФИГУРАЦИЯ PROACTIVE AI PLANNER BOT
# ==============================================================================

# 1. Telegram Bot Token (ОБЯЗАТЕЛЬНО)
# Получи у @BotFather в Telegram командой /newbot
PLANNER_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Ключ к нейросети (LLM & Whisper)
# Рекомендуется бесплатный и быстрый Groq (https://console.groq.com/keys)
# или OpenRouter (https://openrouter.ai/keys)
PLANNER_API_KEY=gsk_your_api_key_here

# 3. Эндпоинт OpenAI-совместимого API
# Для Groq: https://api.groq.com/openai/v1
# Для OpenRouter: https://openrouter.ai/api/v1
PLANNER_BASE_URL=https://api.groq.com/openai/v1

# 4. Название модели
# Для Groq: llama-3.3-70b-versatile (отлично работает с Function Calling и русским языком)
# Для OpenRouter: meta-llama/llama-3.3-70b-instruct или deepseek/deepseek-chat
PLANNER_MODEL=llama-3.3-70b-versatile

# 5. Модель распознавания голосовых сообщений (Whisper)
PLANNER_WHISPER_MODEL=whisper-large-v3

# 6. Белый список пользователей (Telegram ID через запятую)
# Узнать свой ID можно у бота @userinfobot в Telegram
# Если пусто — бот будет доступен всем, кто ему напишет
PLANNER_ALLOWED_USERS=123456789

# 7. Путь к файлу базы данных SQLite
PLANNER_DB_PATH=planner.db

# 8. Прокси для Telegram (если API недоступен напрямую, как в РФ без VPN)
# AmneziaVPN поднимает локальный прокси на 127.0.0.1:12334 — порт можно
# посмотреть в настройках Amnezia (соединение → прокси). Работает и с обычным VPN-туннелем:
# тогда эта строка не нужна.
PLANNER_TELEGRAM_PROXY=http://127.0.0.1:12334
